// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChatSession {
  id        Int      @id @default(autoincrement())
  sessionId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ChatMessage[]

  @@index([sessionId])
}

model ChatMessage {
  id         Int          @id @default(autoincrement())
  sessionId  String
  sessionRef Int
  role       String       // "user" or "assistant"
  content    String       @db.Text
  createdAt  DateTime     @default(now())
  session    ChatSession  @relation(fields: [sessionRef], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionRef])
}

model KnowledgeBase {
  id        Int      @id @default(autoincrement())
  category  String   // "About", "Services", "FAQ", "Contact", etc.
  question  String?  @db.Text
  answer    String   @db.Text
  source    String   // "excel" or "website"
  metadata  Json?    // Additional metadata as JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([question])
  @@index([category, question])
}

model Analytics {
  id          Int      @id @default(autoincrement())
  question    String   @db.Text
  count       Int      @default(1)
  lastAsked   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([question])
  @@index([count])
}

